# ─── DATABASE ───────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=avaira_v2

# ─── SECURITY ───────────────────────────────────────────────────
# MANDATORY: These must be changed and at least 32 characters long.
# Run 'python scripts/generate_secrets.py' to generate secure values.
AVAIRA_LOG_SECRET=REPLACE_WITH_SECURE_32_BYTE_STRING
AVAIRA_ADMIN_KEY=REPLACE_WITH_SECURE_ADMIN_SECRET
PERMIT_SECRET=REPLACE_WITH_SECURE_32_BYTE_STRING_FOR_PERMITS

# ─── AI MODELS (LITELLM) ────────────────────────────────────────
# Get your keys at https://platform.openai.com/ or https://anthropic.com/
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default models (optional)
# DEFAULT_MODEL=anthropic/claude-3-5-sonnet-20241022

# ─── PAYMENTS & SLASHING ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── AUTH (OAUTH2) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8001/api/auth/x/callback

ADMIN_EMAILS=your_email@example.com

# ─── SMART CONTRACTS (EVM) ──────────────────────────────────────
# Optional addresses for Reputation & Slashing bridges
AGENT_REGISTRY_ADDRESS=
EXECUTION_WALLET_ADDRESS=
FREEZE_SLASH_ADDRESS=
TREASURY_ADDRESS=
REPUTATION_ENGINE_ADDRESS=

# ─── CONFIGURATION ──────────────────────────────────────────────
COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=604800
CORS_ORIGINS=http://localhost:3000
ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
CHAIN_ID=43113
